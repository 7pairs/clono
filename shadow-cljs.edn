{:source-paths ["src/main" "src/test" "target/generated"]
 :builds
 {:cli {:target :esm
        :runtime :node
        :output-dir "target/dev"
        :js-options {:js-provider :import}
        :devtools {:enabled false}
        :modules {:cli {:init-fn clono.main/main}}
        :release {:output-dir "dist"
                  :compiler-options {:source-map true}}}
  :repl {:target :esm
         :runtime :node
         :output-dir "target/repl"
         :js-options {:js-provider :import}
         :modules {:repl {:entries [clono.cli clono.version]}}}
  :test {:target :node-test
         :output-to "target/test/tests.cjs"
         :ns-regexp "-test$"
         :autorun false}}}
