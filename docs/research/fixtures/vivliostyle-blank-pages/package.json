{
  "name": "@clono/research-vivliostyle-blank-pages",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "build:inline:pdf": "vivliostyle build --config vivliostyle.inline.config.mjs --output output/inline-marker.pdf",
    "build:markdown-entries:pdf": "vivliostyle build --config vivliostyle.markdown-entries.config.mjs --output output/markdown-entries.pdf",
    "build:html-entries:pdf": "vivliostyle build --config vivliostyle.html-entries.config.mjs --output output/html-entries.pdf",
    "verify": "npm run verify:pdf",
    "verify:pdf": "node scripts/verify-pdf.mjs"
  },
  "devDependencies": {
    "@vivliostyle/cli": "11.1.0",
    "@vivliostyle/vfm": "2.7.0",
    "mupdf": "1.28.0"
  }
}
